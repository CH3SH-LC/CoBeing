{
  "core": {
    "logLevel": "info",
    "dataDir": "./data",
    "skillsDir": "./skills",
    "promptsDir": "./prompts",
    "memory": {
      "charLimits": {
        "memory": 3000,
        "experience": 5000,
        "user": 2000,
        "tools": 3000
      }
    },
    "todo": {
      "scanInterval": 60000
    },
    "localModel": {
      "enabled": true,
      "path": "./data/models/qwen3.5-2b",
      "contextSize": 8192,
      "filterDebounceMs": 3000
    }
  },
  "agents": [
    "butler",
    "host"
  ],
  "providers": {
    "deepseek": {
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseURL": "https://api.deepseek.com"
    },
    "zhipu": {
      "apiKeyEnv": "ZHIPU_API_KEY",
      "baseURL": "https://open.bigmodel.cn/api/paas/v4",
      "plan": "general"
    },
    "qwen": {
      "apiKeyEnv": "QWEN_API_KEY",
      "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1"
    },
    "minimax": {
      "apiKeyEnv": "MINIMAX_API_KEY",
      "baseURL": "https://api.minimaxi.com/v1"
    },
    "volcengine": {
      "apiKeyEnv": "VOLCENGINE_API_KEY",
      "baseURL": "https://ark.cn-beijing.volces.com/api/v3"
    },
    "moonshot": {
      "apiKeyEnv": "MOONSHOT_API_KEY",
      "baseURL": "https://api.moonshot.cn/v1"
    },
    "mimo": {
      "apiKeyEnv": "MIMO_API_KEY",
      "baseURL": "https://api.xiaomimimo.com/v1"
    }
  },
  "channels": {
    "qqbot": {
      "name": "QQ Bot",
      "enabled": false,
      "type": "qqbot",
      "qqbotAppId": "",
      "qqbotAppSecret": "",
      "bindTo": {
        "type": "agent",
        "agentId": "butler"
      }
    }
  },
  "gui": {
    "enabled": true,
    "wsPort": 18765
  },
  "reviewer": {
    "enabled": true,
    "maxRounds": 3
  },
  "groups": [],
  "mcpServers": {
    "qqbot": {
      "transport": "stdio",
      "command": "node",
      "args": ["packages/mcp-servers/qqbot/dist/index.js"],
      "env": {
        "QQ_BOT_APP_ID": "",
        "QQ_BOT_TOKEN": "",
        "QQ_BOT_AUTO_CONNECT_GATEWAY": "false"
      }
    }
  }
}
